# A direct note held during a player change still gets released.
tap HOME
key w8 down
wait 60
expect voices >0
tap ARP
wait 1500
expect voices 0
key w8 up
tap ARP
expect kids_lights 72
# Both a graph and a home overlay come back after a quick detour.
tap ENV
tap SEL
tap SEL
expect kids 3
expect kids_send.2.1 0
tap FX
tap SEL
tap SEL
