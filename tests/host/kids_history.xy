# Five mixed actions across tracks and a sixth root edit.
wait 300
expect kids_undo 0
expect par1.level 100
turn K1 -3 80
expect par1.level 97
expect kids_undo 1
spin SELECT 1
spin K2 1
expect kids_length 32
tap FX
expect kids_send.2.2 52
tap ENV
expect kids_dsp.2.0 1
spin SELECT 1
tap SEQ
tapkey w0
expect note 3 1 1 60
expect kids_undo 5
expect kids_redo 0
expect kids_history_bytes <160
press HOME
wait 300
expect kids_history 1
expect kids 2
shot kids-history.png
spin K2 3
expect kids_note 60
spin K1 -1
expect note 3 1 1 0
shot kids-history-split.png
spin K1 -4
wait 15
expect kids_undo 0
expect kids_redo 5
expect par1.level 100
expect kids_send.2.2 0
expect kids_dsp.2.0 0
expect playing 0
release HOME
expect kids_history 0
expect kids 2
# Navigation and an audition leave redo available.
spin SELECT -1
expect kids_length 16
spin K3 3
tap HOME
tapkey w0
expect kids_redo 5
# Using K1 immediately after the press still counts as a hold.
press HOME
spin K1 5
release HOME
wait 15
expect kids_undo 5
expect kids_redo 0
expect par1.level 97
expect kids_length 32
expect kids_send.2.2 52
expect kids_dsp.2.0 1
expect note 3 1 1 60
spin SELECT 1
tap SEQ
spin K2 2
expect kids_note 62
tap HOME
tapkey 14
expect kids_note 67
press HOME
spin K1 -1
expect kids_note 60
spin K1 1
expect kids_note 62
release HOME
tap SEQ
press HOME
spin K1 -6
release HOME
expect kids 2
expect kids_note 60
expect note 3 1 1 0
expect par1.level 100
expect kids_undo 0
expect kids_redo 6
tapkey w2
expect kids_undo 1
expect kids_redo 0
expect note 3 1 3 60
press HOME
wait 300
release HOME
expect kids 2
tap HOME
expect kids 1

# Reversible typed swaps restore both banks and the exact kit velocity lane.
reboot
wait 300
tap SEQ
tapkey w0
spin K1 -29
expect stepvel 1 1 1 71
spin PRESET -1
expect kids_category 1
expect note 1 1 1 0
tapkey w2
expect note 1 1 3 60
spin PRESET 1
expect kids_category 2
expect note 1 1 1 1
expect stepvel 1 1 1 71
expect kids_undo 5
press HOME
spin K1 -1
expect kids_category 1
expect note 1 1 3 60
spin K1 -1
expect note 1 1 3 0
spin K1 -1
expect kids_category 2
expect note 1 1 1 1
expect stepvel 1 1 1 71
spin K1 3
release HOME
expect kids_category 2
expect stepvel 1 1 1 71
spin PRESET -1
expect note 1 1 3 60
expect kids_undo 6
expect kids_history_bytes <22000

# A take including overlapped notes is one action. It does not touch the transport.
reboot
wait 300
spin SELECT 1
spin K3 2
expect kids_undo 1
step 2 1 2 55 100
tap REC
tap PLAY
key 7 down
wait 25
key 7 up
wait 60
expect noteat 2 1 2 1 55
expect noteat 2 1 2 2 60
expect noteat 2 1 2 3 64
expect noteat 2 1 2 4 67
spin K1 -12
expect par2.level 88
tap REC
expect kids_undo 3
expect playing 1
press HOME
spin K1 -1
expect noteat 2 1 2 1 55
expect noteat 2 1 2 2 0
expect par2.level 88
expect playing 1
spin K1 -1
expect par2.level 100
spin K1 2
expect noteat 2 1 2 4 67
expect slen 2 2 >0
expect par2.level 88
release HOME
expect playing 1
tap REC
tap REC
expect kids_undo 3
tap PLAY
expect playing 0
reboot
wait 300
expect kids_undo 0
expect kids_redo 0

# An upcoming step's velocity remains reversible before the note is inserted.
tap SEQ
tapkey w0
tapkey w0
spin K1 -13
expect kids_velocity 87
press HOME
spin K1 -1
expect kids_velocity 100
spin K1 1
expect kids_velocity 87
release HOME
tapkey w0
expect stepvel 1 1 1 87
press HOME
spin K1 -1
expect note 1 1 1 0
expect kids_velocity 87
spin K1 1
expect stepvel 1 1 1 87
release HOME

# Eleven separately spaced edits leave ten, with only the first evicted.
reboot
wait 300
spin K1 -1
wait 370
spin K1 -1
wait 370
spin K1 -1
wait 370
spin K1 -1
wait 370
spin K1 -1
wait 370
spin K1 -1
wait 370
spin K1 -1
wait 370
spin K1 -1
wait 370
spin K1 -1
wait 370
spin K1 -1
wait 370
spin K1 -1
wait 370
expect par1.level 89
expect kids_undo 10
press HOME
spin K1 -10
expect par1.level 99
expect kids_redo 10
spin K1 10
expect par1.level 89
release HOME
