wait 300
expect kids 1
expect kids_adult 0
expect kids_shelf_mask 0
expect project_slot 0
# A typed alternate melody bank and the drum velocity are both stored.
spin PRESET -1
tap SEQ
tapkey w2
expect note 1 1 3 60
spin PRESET 1
tapkey w0
spin K1 -20
expect stepvel 1 1 1 80
tap HOME
spin K2 1
tap FX
spin K1 7
tap SAVE
expect kids_shelf_mask 1
expect kids_slot_size.1 >100
expect dirty 0
press HOME
spin K1 -1
expect kids_shelf_mask 0
spin K1 1
expect kids_shelf_mask 1
release HOME
# Save two more distinct revisions into free space.
tap HOME
spin SELECT 1
spin K1 -20
tap SAVE
expect kids_slot 2
expect kids_shelf_mask 3
spin K1 -10
tap SAVE
expect kids_slot 3
expect kids_shelf_mask 7
expect par2.level 70
tap GLO
spin K3 1
expect kids_slot 1
expect par2.level 70
wait 1850
shot kids-song-shelf.png
tap EDIT
expect kids_dialog 0
expect trk 1
expect par2.level 100
expect kids_length 32
expect stepvel 1 1 1 80
expect kids_send.1.2 59
press HOME
spin K1 -1
expect par2.level 70
spin K1 1
expect par2.level 100
release HOME
# Dirty opens ask before replacing the work; HOME cancels without a write.
tap HOME
spin K1 -5
tap GLO
spin K3 1
tap EDIT
expect kids_dialog 1
shot kids-open-confirm.png
tap HOME
expect kids_dialog 0
expect par1.level 95
tap EDIT
tap EDIT
expect kids_dialog 0
expect par2.level 80
# A full protected shelf asks for PIN and then a separate confirmation.
tap SAVE
expect kids_dialog 2
tapkey w0
tapkey w0
tapkey w0
tapkey w0
tap SAVE
expect kids_dialog 2
tap HOME
expect kids_dialog 0
tap SAVE
tapkey w0
tapkey w1
tapkey w2
tapkey w3
tap SAVE
expect kids_dialog 4
tap HOME
expect kids_shelf_mask 7
# GLO taps count distinct presses within three seconds.
tap GLO
tap GLO
tap GLO
tap GLO
expect kids_adult 0
wait 3200
tap GLO
expect kids_adult 0
tap GLO
tap GLO
tap GLO
tap GLO
expect kids_adult 1
shot kids-adult.png
spin K4 1
expect kids_dialog 5
wait 25
shot kids-delete-confirm.png
tap SAVE
expect kids_shelf_mask 5
press HOME
spin K1 -1
expect kids_shelf_mask 7
spin K1 1
expect kids_shelf_mask 5
release HOME
tap SAVE
expect kids_shelf_mask 7
expect kids_dialog 0
reboot
wait 300
expect kids_adult 0
expect kids_shelf_mask 7
expect kids_undo 0
tap GLO
tap EDIT
expect trk 1
expect stepvel 1 1 1 80
spin PRESET -1
expect note 1 1 3 60
# PIN-protected deletion and redo, with a failed commit between.
tap GLO
spin K3 2
spin K4 1
expect kids_dialog 3
tapkey w0
tapkey w1
tapkey w2
tapkey w3
tap SAVE
expect kids_dialog 5
kids-shelf-fail
tap SAVE
expect kids_shelf_mask 7
spin K4 1
tapkey w0
tapkey w1
tapkey w2
tapkey w3
tap SAVE
tap SAVE
expect kids_shelf_mask 3
kids-shelf-conflict 3
press HOME
spin K1 -1
expect kids_shelf_mask 3
expect kids_redo 0
release HOME
