# The earlier Steps editor remains accessible from the playable HOME screen.
kids-entry
expect kids 1
tap SEQ
expect kids 2
tapkey w0
expect note 1 1 1 1
tapkey b1
tapkey w0
expect note 1 1 1 1
expect noteat 1 1 1 1 3
spin K2 3
expect kids_bar 4
tapkey w15
expect note 1 1 64 2
tap OCT+
expect kids_octave 1
expect kids_bar 4
tapkey w15
expect note 1 1 64 0
tap HOME
expect kids 1
tap EDIT
expect kids 3
spin SELECT 1
expect trk 2
